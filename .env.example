# All optional. The project runs end to end with none of these set.

# Free key, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternative provider. Needs prepaid credits at console.anthropic.com
# (a Claude Pro subscription does NOT include API access).
ANTHROPIC_API_KEY=

# Razorpay test mode. Without these the mock gateway is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Safety switch. 1 = never touch a real API. Live execution must be opt-in.
REBOUND_DRY_RUN=1
